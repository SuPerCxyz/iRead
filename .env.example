# iRead 环境变量样例（容器 / 当前代码）
#
# 用法：
#   cp .env.example .env
#   docker compose up -d
#
# .env 只供 compose 读取；compose.yaml 的 environment 会覆盖容器内的关键路径与监听地址。
# 本机直接运行 server 时不要 source 本文件：其中的 IREAD_ADDR=0.0.0.0:8080
# 是容器内监听值，直接运行应使用默认的 127.0.0.1:8080。
# 开发环境（Vite 5173 + Go 8082 + data-dev）请按 README 显式传环境变量，
# 并设置 IREAD_PUBLIC_ORIGIN=http://127.0.0.1:5173。
# 不要提交真实密钥；IREAD_SETUP_TOKEN 如填写，只放在未提交的 .env 中。

# 监听地址。容器内必须是 0.0.0.0:8080（由 compose 固定）；
# 本机开发默认 127.0.0.1:8080，README 开发示例使用 8082。
IREAD_ADDR=0.0.0.0:8080

# 非回环监听显式开关。容器内必须为 1；本机默认空（拒绝非回环）。
# 它只允许容器内监听，不代表可以把宿主机端口发布到 0.0.0.0。
IREAD_ALLOW_NON_LOOPBACK=1

# 运行环境：development | staging | production（默认 development）。
# 部署到生产时必须设为 production；此时若同时设置 IREAD_DEV_NO_AUTH=1，
# 配置加载会直接失败，进程以非零状态退出。未知取值同样拒绝启动。
IREAD_ENV=development

# 仅本机/可信开发网络：显式设为 1 时跳过密码、会话、CSRF 与 Origin 校验，
# 所有 /api/v1 接口无需登录即可访问；不会创建用户或会话，也不签发 Cookie。
# 默认留空（保持正常认证）。容器经 env_file 传入后同样生效，
# 严禁在生产或公网环境启用；过期后请删除或置空。
IREAD_DEV_NO_AUTH=

# 浏览器实际访问来源，用于 Origin 校验与 Secure Cookie 判定。
# 必须与地址栏完全一致，只写 scheme/host/port（可带结尾 /），
# 不得包含路径、查询、片段或用户信息。
# - 默认回环 HTTP：http://127.0.0.1:8080
# - HTTPS 反向代理：https://read.example.com（此时 Cookie 自动带 Secure）
# - 本机开发经 Vite 5173：http://127.0.0.1:5173
IREAD_PUBLIC_ORIGIN=http://127.0.0.1:8080

# 可选首次安装令牌。容器/反向代理部署必须设置，或在初始化完成前
# 确保 /api/v1/auth/setup 对外不可达。设置后 setup 需在页面输入该令牌
# 或通过 X-Setup-Token 请求头提供；令牌不写入 URL、日志或响应。
# 留空表示未启用，此时 setup 只接受回环 RemoteAddr。
# 注意：容器内 RemoteAddr 通常是 Docker 网桥/代理地址，不是回环；
# 因此容器首次启动前必须填写，否则 setup 会返回 403 local_only。
# 生成示例：openssl rand -base64 32
IREAD_SETUP_TOKEN=

# 前端构建产物目录。必须存在且包含 index.html。
# 容器内固定 /app/web；本机开发默认 ../web/dist（相对 server 工作目录）。
IREAD_WEB_DIR=/app/web

# 图书原件目录（上传原件与 .staging 临时文件）。
# 容器内固定 /data/books；本机开发默认 ../data/books。
IREAD_BOOKS_DIR=/data/books

# SQLite 目录，数据库文件为 iread.db。
# 容器内固定 /data/db；本机开发默认 ../data/db。
IREAD_DB_DIR=/data/db

# 派生缓存目录（封面、漫画页等，可重建；清理不影响原件/数据库）。
# 容器内固定 /data/cache；本机开发默认 ../data/cache。
IREAD_CACHE_DIR=/data/cache

# 日志级别：debug | info | warn | error。
IREAD_LOG_LEVEL=info

# 日志格式：text | json。
IREAD_LOG_FORMAT=text

# 索引 worker 数；当前上限固定为 1，非法/越界值收敛为 1。
IREAD_INDEX_WORKERS=1

# 仅用于 compose 构建参数与镜像版本注入，不是服务运行时变量。
IREAD_VERSION=0.1.0

# 构建期依赖源（可选，不是运行时变量）。默认使用官方源；
# 网络受限时可取消注释切换镜像，lockfile / go.sum 校验不变。
# IREAD_NPM_REGISTRY=https://registry.npmmirror.com
# IREAD_GOPROXY=https://goproxy.cn,direct
